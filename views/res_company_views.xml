<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Champ "Email du biologiste" sur la fiche societe -->
    <record id="view_company_form_syslab" model="ir.ui.view">
        <field name="name">res.company.form.syslab</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/notebook" position="before">
                <group string="SysLab" name="syslab">
                    <field name="syslab_email_biologiste" widget="email"
                           placeholder="biologiste@syslab.tn (vide = email de l'utilisateur connecte)"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Configuration > Laboratoire : ouvre directement la societe principale -->
    <record id="action_syslab_laboratoire" model="ir.actions.act_window">
        <field name="name">Laboratoire</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">form</field>
        <field name="res_id" ref="base.main_company"/>
    </record>
</odoo>
