<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree -->
    <record id="view_medecin_tree" model="ir.ui.view">
        <field name="name">syslab.medecin.tree</field>
        <field name="model">syslab.medecin</field>
        <field name="arch" type="xml">
            <tree string="Medecins">
                <field name="name"/>
                <field name="specialite"/>
                <field name="telephone"/>
                <field name="email"/>
                <field name="demande_count" string="Demandes"/>
            </tree>
        </field>
    </record>

    <!-- Form -->
    <record id="view_medecin_form" model="ir.ui.view">
        <field name="name">syslab.medecin.form</field>
        <field name="model">syslab.medecin</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <!-- Smart button : demandes prescrites par ce medecin -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_voir_demandes" type="object"
                                class="oe_stat_button" icon="fa-flask">
                            <field name="demande_count" widget="statinfo" string="Demandes"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Dr. ..."/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="specialite"/>
                        </group>
                        <group>
                            <field name="telephone"/>
                            <field name="email"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search -->
    <record id="view_medecin_search" model="ir.ui.view">
        <field name="name">syslab.medecin.search</field>
        <field name="model">syslab.medecin</field>
        <field name="arch" type="xml">
            <search string="Rechercher un medecin">
                <field name="name"/>
                <field name="specialite"/>
                <field name="telephone"/>
                <field name="email"/>

                <!-- Coordonnees manquantes (utile pour envoyer les bulletins) -->
                <filter name="sans_email" string="Sans email" domain="[('email', '=', False)]"/>
                <filter name="sans_telephone" string="Sans telephone" domain="[('telephone', '=', False)]"/>

                <group expand="0" string="Grouper par">
                    <filter name="group_specialite" string="Specialite"
                            context="{'group_by': 'specialite'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_medecin" model="ir.actions.act_window">
        <field name="name">Medecins</field>
        <field name="res_model">syslab.medecin</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
