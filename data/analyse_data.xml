<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="analyse_glycemie" model="syslab.analyse">
            <field name="name">Glycemie a jeun</field>
            <field name="code">GLY</field>
            <field name="famille">biochimie</field>
            <field name="unite">g/L</field>
            <field name="borne_min">0.70</field>
            <field name="borne_max">1.10</field>
            <field name="prix">8.000</field>
        </record>

        <record id="analyse_cholesterol" model="syslab.analyse">
            <field name="name">Cholesterol total</field>
            <field name="code">CHOL</field>
            <field name="famille">biochimie</field>
            <field name="unite">g/L</field>
            <field name="borne_min">0.0</field>
            <field name="borne_max">2.00</field>
            <field name="prix">12.000</field>
        </record>

        <record id="analyse_triglycerides" model="syslab.analyse">
            <field name="name">Triglycerides</field>
            <field name="code">TRIG</field>
            <field name="famille">biochimie</field>
            <field name="unite">g/L</field>
            <field name="borne_min">0.0</field>
            <field name="borne_max">1.50</field>
            <field name="prix">12.000</field>
        </record>

        <record id="analyse_creatinine" model="syslab.analyse">
            <field name="name">Creatinine</field>
            <field name="code">CREA</field>
            <field name="famille">biochimie</field>
            <field name="unite">mg/L</field>
            <field name="borne_min">6.0</field>
            <field name="borne_max">12.0</field>
            <field name="prix">10.000</field>
        </record>

        <record id="analyse_hemoglobine" model="syslab.analyse">
            <field name="name">Hemoglobine</field>
            <field name="code">HB</field>
            <field name="famille">hematologie</field>
            <field name="unite">g/dL</field>
            <field name="borne_min">12.0</field>
            <field name="borne_max">16.0</field>
            <field name="prix">10.000</field>
        </record>

        <!-- HbA1c : utilisee par le modele IA (couche 2) si elle figure dans la demande.
             Normale < 5,7 % ; 5,7 a 6,4 % = prediabete ; >= 6,5 % = seuil diagnostique OMS. -->
        <record id="analyse_hba1c" model="syslab.analyse">
            <field name="name">Hemoglobine glyquee (HbA1c)</field>
            <field name="code">HBA1C</field>
            <field name="famille">biochimie</field>
            <field name="unite">%</field>
            <field name="borne_min">4.0</field>
            <field name="borne_max">5.6</field>
            <field name="prix">25.000</field>
        </record>

    </data>
</odoo>
